# Public Firebase web app settings. Never put service-account or provider secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=

# Optional local-only Auth emulator. Use the same project ID as the backend.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Public Picker key restricted to Google Picker + Drive APIs and allowed website referrers.
VITE_GOOGLE_PICKER_API_KEY=
# Numeric Cloud project number; must match the backend Google OAuth client project.
VITE_GOOGLE_PROJECT_NUMBER=
